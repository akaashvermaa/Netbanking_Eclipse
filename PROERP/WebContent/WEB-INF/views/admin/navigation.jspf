<%
    String adminRoot = request.getContextPath() + "/admin";
    String adminRoute = (String) request.getAttribute("jakarta.servlet.forward.servlet_path");
    String activeSection = "/admin/queue".equals(adminRoute) ? "queue"
            : "/admin/dashboard".equals(adminRoute) ? "overview"
            : "/admin/finance".equals(adminRoute) ? "finance"
            : "/admin/requests".equals(adminRoute) ? "requests"
            : "/admin/audit".equals(adminRoute) ? "audit"
            : "/admin/password".equals(adminRoute) ? "password" : "customers";
    String[][] navLinks = {
        {"overview", "/dashboard", "Overview"},
        {"queue", "/queue", "Review queue"},
        {"customers", "/customers", "Customers & Accounts"},
        {"finance", "/finance", "Balances & Loans"},
        {"requests", "/requests", "Customer requests"},
        {"audit", "/audit", "Audit history"}
    };
%>
<a class="console-skip" href="#admin-main">Skip to main content</a>
<aside class="sidebar">
    <a class="console-brand" href="<%= adminRoot %>/dashboard">
        <span class="console-mark" aria-hidden="true">P</span>
        <span>PROERP <small>Administration</small></span>
    </a>
    <nav class="admin-nav" aria-label="Administration">
        <% for (String[] link : navLinks) { %>
            <a href="<%= adminRoot + link[1] %>" <%= link[0].equals(activeSection) ? "class=\"active\" aria-current=\"page\"" : "" %>>
                <%= link[2] %>
            </a>
        <% } %>
    </nav>
    <div class="sidebar-footer">
        <div class="console-session">
            <div><strong><%= com.netbanking.util.Html.escape((String) session.getAttribute("adminUsername")) %></strong><small>Administrator</small></div>
            <a class="console-sublink" href="<%= adminRoot %>/password">Change password</a>
        </div>
        <form method="post" action="<%= adminRoot %>/logout">
            <input type="hidden" name="_csrf" value="${requestScope.csrfToken}">
            <button class="button button-outline" type="submit">Sign out</button>
        </form>
    </div>
</aside>
